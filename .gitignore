# Local Conda environment and package cache
.conda/

# Runtime data must never be committed
data/
backups/

# Python caches and tooling
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Local configuration and secrets
.env
*.local.toml

# Windows build and release outputs. Generated bundles may contain local data.
packaging/build/
packaging/build-*/
packaging/dist/
packaging/dist-*/
packaging/release/
packaging/README-data-zh-CN.txt
packaging/RELEASE-NOTES-v*-zh-CN.txt
*.zip

# IDE and OS files
.idea/
.vscode/
Thumbs.db
.DS_Store
