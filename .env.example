# 高德开放平台的 Web 服务类型 Key（不需要 JS 安全密钥）
TSUBASA_AMAP_WEB_SERVICE_KEY=

# 天地图浏览器端 Key（tk）；配置后优先使用国内底图
TSUBASA_TIANDITU_BROWSER_KEY=

# 本地“飞羽精灵”（Ollama）
TSUBASA_FEATHER_ASSISTANT_ENABLED=true
TSUBASA_FEATHER_ASSISTANT_BASE_URL=http://127.0.0.1:11434
TSUBASA_FEATHER_ASSISTANT_MODEL=feiyu-jingling
TSUBASA_FEATHER_ASSISTANT_TIMEOUT_SECONDS=120
TSUBASA_FEATHER_ASSISTANT_CONTEXT_SIZE=8192
TSUBASA_FEATHER_ASSISTANT_MAX_OUTPUT_TOKENS=512

# OpenAI 兼容外部模型的 Base URL、模型名和 Key 请在首页“API 管理”中填写，
# 这些密钥会保存在跨平台本地 JSON 配置中，不应直接写入本文件。
# 配置文件含明文密钥，需依赖本机账户和目录权限保护。
